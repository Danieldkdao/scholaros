{
  "name": "@scholaros/cloud-db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e ../../apps/web/.env.local -e ../../apps/web/.env -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../../apps/web/.env.local -e ../../apps/web/.env -- drizzle-kit migrate",
    "db:studio": "dotenv -e ../../apps/web/.env.local -e ../../apps/web/.env -- drizzle-kit studio"
  },
  "dependencies": {
    "@scholaros/env": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
