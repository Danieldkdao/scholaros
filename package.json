{
  "name": "scholaros",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:desktop": "pnpm --filter @scholaros/desktop dev",
    "dev:desktop:session": "pnpm --filter @scholaros/desktop dev -- --session-only",
    "dev:web": "pnpm --filter @scholaros/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint apps packages",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "start": "pnpm --filter @scholaros/desktop start",
    "package": "pnpm --filter @scholaros/desktop package",
    "make": "pnpm --filter @scholaros/desktop make",
    "release": "pnpm --filter @scholaros/desktop release",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio",
    "auth": "pnpm --filter @scholaros/web auth",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.89.0"
  }
}
