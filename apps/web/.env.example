# Copy to apps/web/.env.local and supply your Neon connection string.
DATABASE_URL=
# Optional direct URL for migrations when DATABASE_URL uses the pooled endpoint.
DATABASE_URL_UNPOOLED=

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MAILJET_API_KEY=
MAILJET_API_SECRET=
SENDER_EMAIL=

# Meta AI inference (server only).
META_API_KEY=
META_MODEL=muse-spark-1.3

# Server-owned academic browser navigation mode: decision or inout.
BROWSER_NAV=decision
