GITHUB_CLIENT_SECRET=

MAILJET_API_KEY=
MAILJET_API_SECRET=
SENDER_EMAIL=

# Optional AI onboarding preview (server only)
TYPESAFE_API_KEY=
BASETEN_API_KEY=
META_MODEL=meta-models/muse-spark-open-1026
